# Page URLs → the page that handles them (200 = serve that file, the URL stays as it is).
# Everything else is a file under /static/.
#
# No two wildcards may overlap: Cloudflare doesn't reliably let the first of two matching
# wildcard rules win (/admin/* took /admin/edit/x), so the admin panel's tabs are listed by name.
/                /static/viewer.html  200
/admin           /static/admin.html   200
/admin/          /static/admin.html   200
/admin/uploads   /static/admin.html   200
/admin/home      /static/admin.html   200
/admin/login     /static/login.html   200
/admin/edit      /static/editor.html  200
/admin/edit/*    /static/editor.html  200
/docs/*          /static/viewer.html  200
